# Nest (Railway injects PORT in production — Nest defaults to 3000 locally).
# Do NOT set PORT in local .env: Angular CLI also reads PORT and would bind FE to 3000.
# PORT=
CORS_ORIGIN=http://localhost:4200

# Postgres (Railway). Locally: `docker compose up -d db` (see docker-compose.yml) and
#   DATABASE_URL=postgresql://baza:baza@localhost:5432/baza
# On Railway it is the reference variable ${{Postgres.DATABASE_URL}} (private *.railway.internal host).
# TLS is off for localhost / *.railway.internal and on elsewhere; override with DATABASE_SSL=disable|require.
# Migrations run at API boot (advisory lock); skip with DATABASE_RUN_MIGRATIONS=false.
DATABASE_URL=

# Integration tests only: a scratch database (each test file uses its own schema). Mandatory in CI.
# TEST_DATABASE_URL=postgresql://baza:baza@localhost:5432/baza_test

# Auth (own identity module — see .claude/skills/baza-auth)
# ES256 keyring, base64(JSON([{kid,status:"active"|"retiring",privateKeyPemBase64}])), exactly one active.
# Unset in dev = ephemeral key (sessions do not survive a restart). REQUIRED in production.
# AUTH_JWT_SIGNING_KEYS=
# Absolute SPA origin used in emailed links. REQUIRED in production.
AUTH_WEB_BASE_URL=http://localhost:4200
# Origins allowed on cookie endpoints (defaults to CORS_ORIGIN). Exact match, no wildcard.
# AUTH_ALLOWED_ORIGINS=
# Secure cookies (`__Host-` prefix): default true in production, false elsewhere.
# AUTH_SECURE_COOKIES=
# Set to false ONLY while mail is not wired up: users can then log in without verifying the email.
# AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Same value as the Cloudflare Pages project variable: lets the API trust the client IP the Pages
# proxy forwards (rate limiting). Unset = header ignored.
# PROXY_SHARED_SECRET=

# Mail (Resend). MAIL_TRANSPORT=log (default without a key) only logs messages, links included in dev.
# RESEND_API_KEY=
# MAIL_FROM=Baza <no-reply@your-domain>
# MAIL_REPLY_TO=

# Sentry (optional — empty / unset = SDK no-op; local + CI stay green)
# API DSN: set on Railway Variables as SENTRY_DSN (project baza-api).
# FE DSN: public browser DSN — GitHub Actions secret SENTRY_DSN for the Pages
#   build job (write-fe-production-env.mjs → environment.sentryDsn). Not required
#   in local .env unless you want browser events while developing.
# Optional: SENTRY_ENVIRONMENT=development|production
# NEVER put SENTRY_AUTH_TOKEN in this file, FE env, or Cloudflare Pages —
#   auth token is GitHub Actions (+ Railway build) only, for source map upload.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=

# Cloudflare R2 (Railway / local Nest only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=baza-uploads
# Public base URL for objects — enable R2 bucket public access and use the r2.dev URL
# or your custom domain (e.g. https://pub-xxxxx.r2.dev). Do NOT use the S3 API host
# (https://<account_id>.r2.cloudflarestorage.com) — browsers cannot load images from it.
R2_PUBLIC_URL=

# Private R2 bucket for driver CVs (S-04) — NOT on the public logo domain.
# Account/keys fall back to R2_* above when unset; R2_PRIVATE_BUCKET is required.
# R2_PRIVATE_ACCOUNT_ID=
# R2_PRIVATE_ACCESS_KEY_ID=
# R2_PRIVATE_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=

# Playwright E2E (optional — authenticated specs only; a VERIFIED company account)
# E2E_BASE_URL=http://localhost:4200
# E2E_EMAIL=
# E2E_PASSWORD=
