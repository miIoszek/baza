{
  "name": "baza-frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "baza",
  "sourceRoot": "apps/baza-frontend/src",
  "tags": [
    "type:app",
    "scope:frontend"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/baza-frontend",
        "browser": "apps/baza-frontend/src/main.ts",
        "tsConfig": "apps/baza-frontend/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/baza-frontend/public"
          }
        ],
        "styles": [
          "node_modules/leaflet/dist/leaflet.css",
          "apps/baza-frontend/src/styles.scss"
        ],
        "allowedCommonJsDependencies": [
          "leaflet",
          "leaflet-polylinedecorator"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/baza-frontend/src/environments/environment.ts",
              "with": "apps/baza-frontend/src/environments/environment.production.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "baza-frontend:build:production"
        },
        "development": {
          "buildTarget": "baza-frontend:build:development"
        }
      },
      "options": {
        "port": 4200,
        "proxyConfig": "apps/baza-frontend/proxy.conf.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "baza-frontend:build",
        "staticFilePath": "dist/apps/baza-frontend/browser",
        "spa": true
      }
    }
  }
}
