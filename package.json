{
  "name": "@baza/source",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "serve:api": "nx serve baza-api",
    "serve:frontend": "node scripts/ensure-fe-env.mjs && nx serve baza-frontend --port=4200",
    "dev:db": "docker compose up -d db",
    "dev:seed": "node scripts/dev-seed.mjs",
    "build": "node scripts/ensure-fe-env.mjs && nx run-many -t build -p baza-api,baza-frontend",
    "build:api": "nx build baza-api --configuration=production",
    "build:frontend:ci": "node scripts/ensure-fe-env.mjs && node scripts/write-fe-production-env.mjs && nx build baza-frontend --configuration=production",
    "start": "node dist/apps/baza-api/main.js",
    "lint": "nx run-many -t lint -p baza-api,baza-frontend",
    "test": "nx run-many -t test -p baza-api,baza-frontend",
    "test:api:db": "node scripts/with-env.mjs nx test baza-api --skip-nx-cache",
    "test:e2e": "playwright test",
    "test:e2e:auth": "node scripts/with-env.mjs playwright test --project=firefox-authenticated",
    "graph": "nx graph",
    "prepare": "lefthook install || true"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "~22.1.0",
    "@angular-devkit/schematics": "~22.1.0",
    "@angular/build": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/language-service": "~22.1.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "^23.2.0",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/jest": "23.2.0",
    "@nx/js": "^23.2.0",
    "@nx/nest": "^23.2.0",
    "@nx/node": "^23.2.0",
    "@nx/web": "23.2.0",
    "@nx/webpack": "^23.2.0",
    "@nx/workspace": "23.2.0",
    "@playwright/test": "^1.63.0",
    "@schematics/angular": "~22.1.0",
    "@sentry/webpack-plugin": "^5.4.0",
    "@swc/helpers": "~0.5.18",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/jest": "~30.0.0",
