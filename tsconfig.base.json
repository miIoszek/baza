{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@baza/shared-types": [
        "./libs/shared/types/src/index.ts"
      ],
      "@baza/api-core": [
        "./libs/api/core/src/index.ts"
      ],
      "@baza/ui": [
        "./libs/baza/ui/src/index.ts"
      ],
      "@baza/api-data-access": [
        "./libs/api/data-access/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
